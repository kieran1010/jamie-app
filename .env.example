# Pooled connection string, used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tutorapp"

# Direct (unpooled) connection, used only by `prisma migrate` and
# `prisma db push` — schema changes cannot go through a connection pooler.
#
# Against a plain local Postgres, which does no pooling, set this to the same
# value as DATABASE_URL. Hosted Postgres that pools by default supplies both:
# Neon via the Vercel Marketplace sets DATABASE_URL and DATABASE_URL_UNPOOLED
# for you, so there is nothing to copy by hand.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/tutorapp"

SESSION_COOKIE_SECURE="false"
